# ── Database ──────────────────────────────────────────────
DATABASE_URL="sqlite:///./ai_live_interviewer.db"

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET="change-me"

# ── Local AI (100% free, runs on your machine) ──────────────
# LLM via Ollama. Smarter but slower on CPU: qwen2.5:7b or llama3.1:8b
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
# Speech-to-text. base.en = fast; small.en = more accurate, slower.
WHISPER_MODEL="base.en"
# Text-to-speech voice (downloaded by scripts/setup-local-ai.sh)
PIPER_VOICE="en_US-lessac-medium"

ENVIRONMENT="development"
MAX_INTERVIEW_DURATION_SECONDS=1800
MAX_DAILY_INTERVIEWS_PER_USER=10
